# ==========================================
# CUI Member Skill - 環境變數設定檔 (.env)
# ==========================================

# -------------------------
# A. 執行模式與平台判定 (Core Runtime)
# -------------------------
# Whisper 模式: local (本地端), openai (OpenAI API), azure (Azure OpenAI API)
WHISPER_MODE=local

# 是否使用容器執行腳本 (Truthy: 使用, Falsy: 不使用)
# - Mac: 僅由此值決定是否使用容器
# - Windows: 當 USE_CUDA=true 或 WHISPER_MODE=local 時，會強制使用容器
USE_CONTAINER=false

# 指定容器工具（留空時預設 docker；可改 podman）
# CONTAINER_RUNTIME=podman

# 是否啟用 CUDA（僅 Windows 容器流程有效）
# - true: 使用 cuda 版容器
# - false: 使用 cpu 版容器
# - Mac 會忽略此設定
USE_CUDA=false

# -------------------------
# B. 下載與 Cookies 設定 (Input / Cookies)
# -------------------------
# Mac: 從瀏覽器自動讀取 Cookies（預設 chrome，可改 firefox/edge/safari）
COOKIES_BROWSER=chrome

# Windows 容器化：請先手動匯出 cookies.txt 再指定路徑
# Mac 也可改用此路徑（若不想用 COOKIES_BROWSER）
COOKIES_PATH=./cookies.txt

# -------------------------
# C. 轉譯模型與 API 金鑰 (Transcription Engine)
# -------------------------
# [Local 模式專用] Whisper 模型名稱（Apple Silicon Mac 的 mlx）
WHISPER_MODEL=mlx-community/whisper-medium-mlx-8bit
# WHISPER_MODEL=mlx-community/whisper-large-v3-mlx

# [OpenAI API 模式專用]
OPENAI_API_KEY=your_openai_api_key_here

# [Azure OpenAI API 模式專用]
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=whisper
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# -------------------------
# D. 同步至 Gist（選擇性）
# -------------------------
# 備註：若未同時填寫以下兩項，系統將自動跳過 Gist 同步功能
# GitHub Personal Access Token (需具備 gist 權限)
GITHUB_TOKEN=your_github_token_here
# 目標 Gist ID (例如 gist.github.com/username/GIST_ID 中的英數代碼)
GIST_ID=your_gist_id_here
